spirv_generated_headers = []

spirv_generated_headers += custom_target('build-version.inc',
    command : [update_build_version, '@INPUT@', '@OUTPUT@'],
    input : '../CHANGES',
    output : 'build-version.inc',
    build_always_stale : true,
    build_by_default : true,
)

spirv_generated_headers += custom_target('core_tables',
    command : [
        gen_core_tables,
        '--core-tables-body-output=@OUTPUT0@',
        '--core-tables-header-output=@OUTPUT1@',
        '--spirv-core-grammar=@INPUT0@',
        '--extinst=,@INPUT1@',
        '--extinst=,@INPUT2@',
        '--extinst=CLDEBUG100_,@INPUT3@',
        '--extinst=SHDEBUG100_,@INPUT4@',
        '--extinst=,@INPUT5@',
        '--extinst=,@INPUT6@',
        '--extinst=,@INPUT7@',
        '--extinst=,@INPUT8@',
        '--extinst=,@INPUT9@',
        '--extinst=,@INPUT10@',
        '--extinst=,@INPUT11@',
        '--extinst=TOSA_,@INPUT12@',
        '--extinst=,@INPUT13@',
        '--extinst=,@INPUT14@',
        '--extinst=,@INPUT15@',
        '--extinst=,@INPUT16@',
    ],
    input : [
        file_unified1_spirv_core_grammar_json,
        file_unified1_extinst_glsl_std_450_grammar_json,
        file_unified1_extinst_opencl_std_100_grammar_json,
        file_unified1_extinst_opencl_debuginfo_100_grammar_json,
        file_unified1_extinst_nonsemantic_shader_debuginfo_grammar_json,
        file_unified1_extinst_spv_amd_shader_explicit_vertex_parameter_grammar_json,
        file_unified1_extinst_spv_amd_shader_trinary_minmax_grammar_json,
        file_unified1_extinst_spv_amd_gcn_shader_grammar_json,
        file_unified1_extinst_spv_amd_shader_ballot_grammar_json,
        file_unified1_extinst_debuginfo_grammar_json,
        file_unified1_extinst_nonsemantic_clspvreflection_grammar_json,
        file_unified1_extinst_nonsemantic_vkspreflection_grammar_json,
        file_unified1_extinst_tosa_001000_1_grammar_json,
        file_unified1_extinst_arm_motion_engine_100_grammar_json,
        file_unified1_extinst_nonsemantic_graph_debuginfo_grammar_json,
        file_unified1_extinst_arm_experimental_ml_operations_grammar_json,
        file_unified1_extinst_nonsemantic_debugprintf_grammar_json,
    ],
    output : ['core_tables_body.inc', 'core_tables_header.inc'],
    depend_files : gen_core_tables_deps,
)

spirv_generated_headers += custom_target('DebugInfo.h',
    command : [
        gen_language_headers,
        '--extinst-grammar', '@INPUT@',
        '--extinst-output-path', '@OUTPUT@',
    ],
    input : file_unified1_extinst_debuginfo_grammar_json,
    output : 'DebugInfo.h',
)

spirv_generated_headers += custom_target('OpenCLDebugInfo100.h',
    command : [
        gen_language_headers,
        '--extinst-grammar', '@INPUT@',
        '--extinst-output-path', '@OUTPUT@',
    ],
    input : file_unified1_extinst_opencl_debuginfo_100_grammar_json,
    output : 'OpenCLDebugInfo100.h',
)

spirv_generated_headers += custom_target('generators.inc',
    command : [
        gen_registry_tables,
        '--xml', '@INPUT@',
        '--generator-output', '@OUTPUT@',
    ],
    input : file_spir_v_xml,
    output : 'generators.inc',
)

libspirv_tools = library('SPIRV-Tools',
    spirv_generated_headers,
    spirv_src,
    cpp_pch : 'meson-pch/pch.h',
    dependencies : spvhdr_dep,
    include_directories : [private_incdir, public_incdir],
    build_by_default : not meson.is_subproject(),
    override_options : cross_options,
)

spirv_tools_dep = declare_dependency(
    link_with : libspirv_tools,
    include_directories : public_incdir,
    version : meson.project_version(),
)

libspirv_tools_native = library('SPIRV-Tools-native',
    spirv_generated_headers,
    spirv_src,
    cpp_pch : 'meson-pch/pch.h',
    dependencies : spvhdr_dep,
    include_directories : [private_incdir, public_incdir],
    build_by_default : false,
    native : true,
    override_options : native_options,
)

spirv_tools_native_dep = declare_dependency(
    link_with : libspirv_tools_native,
    include_directories : public_incdir,
    version : meson.project_version(),
)

subdir('opt')
subdir('link')
subdir('reduce')
